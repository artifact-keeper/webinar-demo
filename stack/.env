# Demo-only credentials. Committed on purpose so the stack and scripts stay
# in lockstep. Never reuse these values anywhere real.
AK_ADMIN_USER=admin
AK_ADMIN_PASSWORD=WebinarDemo-2026-throwaway
ARTIFACT_KEEPER_VERSION=1.8.0
COMPOSE_PROJECT_NAME=webinar-demo
POSTGRES_PASSWORD=registry-demo
JWT_SECRET=webinar-demo-jwt-secret-at-least-32-bytes
# Host ports and container-name prefix.
AK_NAME_PREFIX=webinar-demo
AK_API_PORT=8080
AK_WEB_PORT=3000
AK_OPENSEARCH_PORT=9200
AK_TRIVY_PORT=8090
AK_JUPYTER_PORT=8888
# To override any of the above locally (e.g. a port is already in use),
# create a git-ignored stack/.env.local with plain KEY=value lines. It is
# layered on top of this file, so only the values you want to change need
# to be listed there.
